# docker compose --env-file docker/offline.env up -d --build
# Small "lite" API image with offline stand-ins: no model download, no Ollama.
# Checks the plumbing (used by CI); answers are NOT semantic or generative.
EKA_DOCKER_FLAVOR=lite
EKA_EMBEDDING_BACKEND=hashing
EKA_RERANKER_BACKEND=hashing
EKA_ENTAILMENT_BACKEND=lexical
EKA_LLM_BACKEND=extractive
EKA_API_MEMORY=1g
