# Web app settings. Copy to web/.env.local (git-ignored) to change them.

# Where the FastAPI backend runs. The browser never calls it directly.
EKA_API_URL=http://localhost:8000

# Seals the session cookie (32+ characters). Leave empty locally: a random one is
# made each time the web server starts, which only means you reconnect after a restart.
# Generate one with:  openssl rand -base64 32
EKA_WEB_SESSION_SECRET=

# true when the site is served over HTTPS (Phase 8). Plain http://localhost needs false.
EKA_WEB_COOKIE_SECURE=false

# Don't send Next.js usage telemetry.
NEXT_TELEMETRY_DISABLED=1
