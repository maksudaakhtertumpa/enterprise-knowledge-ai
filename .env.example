# Copy to .env and adjust. Never commit .env — it is git-ignored.
# Every variable is prefixed EKA_ (Enterprise Knowledge AI).

# --- App ---
EKA_ENVIRONMENT=development        # development | test | production
EKA_DEBUG=false
EKA_API_PREFIX=/api/v1

# --- Logging ---
EKA_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
EKA_LOG_JSON=true                  # false = human-readable lines for local dev

# --- Storage ---
EKA_DATA_DIR=./data                # uploads + SQLite database live here
# EKA_DATABASE_URL=                # leave unset for SQLite in EKA_DATA_DIR

# --- CORS (JSON list) ---
# Empty: the web UI reaches the API through its own server, not the browser.
# Add origins only for a browser app that calls the API directly.
EKA_CORS_ORIGINS=[]

# --- Rate limits (per workspace; token buckets in process memory) ---
EKA_RATE_LIMIT_ENABLED=true
EKA_RATE_LIMIT_ASK_PER_MINUTE=20         # sustained questions per minute
EKA_RATE_LIMIT_ASK_BURST=5               # how many may arrive at once
EKA_RATE_LIMIT_SEARCH_PER_MINUTE=60
EKA_RATE_LIMIT_SEARCH_BURST=20
EKA_RATE_LIMIT_INGEST_PER_MINUTE=60      # uploads + reprocessing
EKA_RATE_LIMIT_INGEST_BURST=30
EKA_RATE_LIMIT_AUTH_FAILURES_PER_MINUTE=10   # failed key checks per client address
EKA_RATE_LIMIT_AUTH_FAILURES_BURST=10
# Reverse proxies whose X-Forwarded-For is believed (JSON list of IPs/CIDRs). Empty locally.
EKA_TRUSTED_PROXIES=[]

# --- API docs (/docs, /redoc, /openapi.json) ---
# Unset: on, except when EKA_ENVIRONMENT=production. true/false to force.
# EKA_API_DOCS=

# --- Uploads ---
EKA_MAX_UPLOAD_MB=20
EKA_MAX_PDF_PAGES=2000
EKA_MAX_DOCX_UNCOMPRESSED_MB=150   # zip-bomb guard

# --- Chunking (tokens counted with the embedding model's tokenizer) ---
EKA_CHUNK_SIZE_TOKENS=400
EKA_CHUNK_OVERLAP_TOKENS=60        # must be < half of chunk size

# --- Embeddings (see docs/MODELS.md) ---
EKA_EMBEDDING_BACKEND=sentence-transformers   # or "hashing": offline, NOT semantic (tests/CI)
EKA_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EKA_EMBEDDING_DEVICE=auto                     # auto -> mps on Apple silicon, cuda, else cpu
EKA_EMBEDDING_BATCH_SIZE=32
EKA_EMBEDDING_PRELOAD=true                    # load at startup so the first search is fast

# --- Search (defaults chosen from measurements on a MacBook Air M4; see eval/README.md) ---
EKA_SEARCH_MAX_TOP_K=50
EKA_SEARCH_DEFAULT_MODE=dense      # bm25 | dense | hybrid — used when a request omits "mode"
EKA_RRF_K=10                       # Reciprocal Rank Fusion constant (best of a 36-setting sweep)
EKA_HYBRID_CANDIDATES=20           # depth of each retriever's list before fusion
EKA_HYBRID_BM25_WEIGHT=0.25
EKA_HYBRID_DENSE_WEIGHT=1.0

# --- Reranking (cross-encoder second stage) ---
EKA_RERANKER_BACKEND=cross-encoder # or "hashing" (offline, NOT semantic) or "none"
EKA_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EKA_RERANKER_DEVICE=auto
EKA_RERANKER_BATCH_SIZE=16
EKA_RERANKER_MAX_LENGTH=512        # tokens for query + passage together
EKA_RERANKER_HALF_PRECISION=true   # float16 on MPS/CUDA: ~half the memory
EKA_RERANKER_PRELOAD=true
EKA_RERANK_CANDIDATES=10           # 10 beat 20 on the M4: same quality, half the latency
EKA_RERANK_BY_DEFAULT=true         # dense+rerank: MRR 0.900 -> 0.962 on the benchmark

# --- Answer generation: local LLM only ($0, no paid APIs) ---
EKA_LLM_BACKEND=ollama             # ollama | extractive (offline stand-in, NOT generative) | none
EKA_OLLAMA_URL=http://localhost:11434
EKA_OLLAMA_MODEL=qwen3.5:4b        # free; install with: ollama pull qwen3.5:4b
EKA_LLM_NUM_CTX=8192               # sent explicitly: Ollama silently truncates over-long prompts
EKA_LLM_MAX_ANSWER_TOKENS=512
EKA_LLM_TEMPERATURE=0.0            # with a fixed seed, answers are repeatable
EKA_LLM_READ_TIMEOUT_S=180         # the first question also loads the model
EKA_LLM_MAX_RETRIES=2              # transient errors only; never on timeouts or missing models
EKA_LLM_KEEP_ALIVE=30m             # keep the model in memory between questions

# --- Answering ---
EKA_ANSWER_PASSAGES=5              # evidence passages shown to the model
EKA_ANSWER_MIN_RERANK_SCORE=0.0    # 0 = off; calibrate with `python -m eval.run_answers`
EKA_ASK_HISTORY=true               # keep question/answer history per workspace

# --- Entailment check: does each answer sentence follow from what it cites? ---
EKA_ENTAILMENT_BACKEND=nli         # nli | lexical (offline stand-in, NOT semantic) | none
EKA_ENTAILMENT_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7   # MIT, multilingual
EKA_ENTAILMENT_DEVICE=auto
EKA_ENTAILMENT_BATCH_SIZE=32
EKA_ENTAILMENT_MAX_LENGTH=512      # tokens for passage + sentence together
EKA_ENTAILMENT_PRELOAD=true
EKA_ENTAILMENT_GRANULARITY=sentences   # best of whole passage and 1..N-sentence windows | passage
EKA_ENTAILMENT_WINDOW_SENTENCES=3
EKA_ANSWER_ENTAILMENT_MODE=remove  # remove | flag (keep, with a warning) | off
EKA_ANSWER_ENTAILMENT_THRESHOLD=0.75  # chosen on the dev set; see docs/evaluation/
