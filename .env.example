# Copy to .env and adjust. Never commit .env — it is git-ignored.
# Every variable is prefixed EKA_ (Enterprise Knowledge AI).

# --- App ---
EKA_ENVIRONMENT=development        # development | test | production
EKA_DEBUG=false
EKA_API_PREFIX=/api/v1

# --- Logging ---
EKA_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
EKA_LOG_JSON=true                  # false = human-readable lines for local dev

# --- Storage ---
EKA_DATA_DIR=./data                # uploads + SQLite database live here
# EKA_DATABASE_URL=                # leave unset for SQLite in EKA_DATA_DIR

# --- CORS (JSON list) ---
EKA_CORS_ORIGINS=["http://localhost:8501"]

# --- Uploads ---
EKA_MAX_UPLOAD_MB=20
EKA_MAX_PDF_PAGES=2000
EKA_MAX_DOCX_UNCOMPRESSED_MB=150   # zip-bomb guard

# --- Chunking (tokens counted with the embedding model's tokenizer) ---
EKA_CHUNK_SIZE_TOKENS=400
EKA_CHUNK_OVERLAP_TOKENS=60        # must be < half of chunk size

# --- Embeddings (see docs/MODELS.md) ---
EKA_EMBEDDING_BACKEND=sentence-transformers   # or "hashing": offline, NOT semantic (tests/CI)
EKA_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EKA_EMBEDDING_DEVICE=auto                     # auto -> mps on Apple silicon, cuda, else cpu
EKA_EMBEDDING_BATCH_SIZE=32
EKA_EMBEDDING_PRELOAD=true                    # load at startup so the first search is fast

# --- Search (defaults chosen from measurements on a MacBook Air M4; see eval/README.md) ---
EKA_SEARCH_MAX_TOP_K=50
EKA_SEARCH_DEFAULT_MODE=dense      # bm25 | dense | hybrid — used when a request omits "mode"
EKA_RRF_K=10                       # Reciprocal Rank Fusion constant (best of a 36-setting sweep)
EKA_HYBRID_CANDIDATES=20           # depth of each retriever's list before fusion
EKA_HYBRID_BM25_WEIGHT=0.25
EKA_HYBRID_DENSE_WEIGHT=1.0

# --- Reranking (cross-encoder second stage) ---
EKA_RERANKER_BACKEND=cross-encoder # or "hashing" (offline, NOT semantic) or "none"
EKA_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EKA_RERANKER_DEVICE=auto
EKA_RERANKER_BATCH_SIZE=16
EKA_RERANKER_MAX_LENGTH=512        # tokens for query + passage together
EKA_RERANKER_HALF_PRECISION=true   # float16 on MPS/CUDA: ~half the memory
EKA_RERANKER_PRELOAD=true
EKA_RERANK_CANDIDATES=10           # 10 beat 20 on the M4: same quality, half the latency
EKA_RERANK_BY_DEFAULT=true         # dense+rerank: MRR 0.900 -> 0.962 on the benchmark

# --- Added in later phases (do not fill in yet) ---
